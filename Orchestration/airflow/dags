from airflow import DAG
from airflow.operators.bash import BashOperator
from datetime import datetime

with DAG('rice_training_pipeline', start_date=datetime(2024, 1, 1), schedule_interval='@weekly') as dag:
    check_data = BashOperator(
        task_id='check_data', 
        bash_command='ls Data/Train'
    )
    
    train_model = BashOperator(
        task_id='train_model', 
        bash_command='python services/train_vision.py'
    )
    
    check_data >> train_model